*&---------------------------------------------------------------------*
*& Include YRST_GH_LCOND_DEAKT_TOP                  - Report YRST_GH_LCOND_DEAKT
*&---------------------------------------------------------------------*

REPORT yrst_gh_lcond_deakt.



TABLES: yrst_gh_lcond, marc.
TYPES: BEGIN OF ty_s_selection,
         bukrs_send  TYPE RANGE OF bukrs,
         matnr       TYPE RANGE OF matnr,
         bukrs_recv  TYPE RANGE OF bukrs,
         werks       TYPE RANGE OF werks_d,
         mmsta       TYPE RANGE OF mmsta,
         monate      TYPE i,
         check_stock TYPE abap_bool,
         testlauf    TYPE abap_bool,
       END OF ty_s_selection.
TYPES: BEGIN OF ty_s_article,
         bukrs_send    TYPE bukrs,
         matnr         TYPE matnr,
         delisted_date TYPE datum,          " MARC-MMSTD
       END OF ty_s_article,
       ty_t_article TYPE SORTED TABLE OF ty_s_article
                         WITH UNIQUE KEY bukrs_send matnr.

TYPES: ty_t_lcond TYPE STANDARD TABLE OF yrst_gh_lcond WITH EMPTY KEY.

TYPES: BEGIN OF ty_s_update,
         old TYPE yrst_gh_lcond,
         new TYPE yrst_gh_lcond,
       END OF ty_s_update,
       ty_t_update TYPE STANDARD TABLE OF ty_s_update WITH EMPTY KEY.

TYPES: BEGIN OF ty_s_log,
         type       TYPE c LENGTH 2,     " OK / EX
         bukrs_send TYPE bukrs,
         matnr      TYPE matnr,
         ausl_datum TYPE datum,
         monate     TYPE i,
         stichtag   TYPE datum,
         bukrs_recv TYPE bukrs,
         vlfkz      TYPE vlfkz,
         werks      TYPE werks_d,
         datbi_alt  TYPE datbi,
         datbi_neu  TYPE datbi,
         meldung    TYPE string,
       END OF ty_s_log,
       ty_t_log TYPE STANDARD TABLE OF ty_s_log WITH EMPTY KEY.



CONSTANTS: BEGIN OF gc_prot_typ,
             ok    TYPE c LENGTH 2 VALUE 'OK',
             error TYPE c LENGTH 2 VALUE 'EX',
           END OF gc_prot_typ.

CONSTANTS: BEGIN OF gc_param,
             objtyp  TYPE char1  VALUE 'P',
             objname TYPE yca_bb_para_objname VALUE 'YRST_LCOND_DEAKT',
             mmsta   TYPE char30 VALUE 'P:MMSTA',
             res_def TYPE YCA_BB_PARA_PARAMETER VALUE 'P:RESIDENZ_DEFAULT',
             res_rel TYPE char30 VALUE 'P:RESIDENZ',
           END OF gc_param.

CONSTANTS: gc_tabname      TYPE tabname    VALUE 'YRST_GH_LCOND',
           gc_cdobjclas    TYPE cdobjectcl VALUE 'YRST_LCOND',
           gc_stock_status TYPE lbbsa      VALUE '01',
           gc_package_size TYPE i          VALUE 10000.